# =============================================================================
# HealthTrack — Git Ignore
# =============================================================================

# ─── Secrets & credentials (NEVER commit these) ──────────────────────────────
.env
*.env
.env.*
!.env.example
backend_nodejs/.env
backend_nodejs/.env.*
!backend_nodejs/.env.example

# Firebase / Google Cloud credential files
**/firebase-adminsdk-*.json
**/serviceAccountKey.json
**/google-services-private*.json
backend_nodejs/healthtrack-*.json

# Flutter Firebase config files (contain live API keys)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
# Allow package.json and package-lock.json but block credential JSON files

# ─── Node.js ─────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ─── Build outputs ────────────────────────────────────────────────────────────
# Allow build/web for Vercel static deployment — Flutter web must be pre-built
/build/[^w]*
/build/w[^e]*
/build/we[^b]*
build/app/
build/.cxx/
build/firebase_core/
build/firebase_messaging/
build/flutter_local_notifications/
build/flutter_plugin_android_lifecycle/
build/flutter_timezone/
build/image_picker_android/
build/native_assets/
build/network_info_plus/
build/path_provider_android/
build/printing/
build/reports/
build/shared_preferences_android/
build/3a99825705ea5132e65ecf51c322b5aa/
build/c6d7d221ac7baa3f988416538c2ed756/
build/*.dill
build/*.cache
build/*.txt
dist/
.dart_tool/

# ─── Flutter/Dart ─────────────────────────────────────────────────────────────
**/doc/api/
**/ios/Flutter/.last_build_id
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
app.*.symbols
app.*.map.json
/android/app/debug
/android/app/profile
/android/app/release
android_backup/

# ─── IDE & OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
*.swp
*.swo
.atom/
.history/
.svn/
.swiftpm/
migrate_working_dir/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
backend_nodejs/test_output.txt

# ─── Test artifacts ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Miscellaneous ────────────────────────────────────────────────────────────
*.class
*.pyc
*.py[cod]
.buildlog/
.build/
# Vercel — keep project binding, ignore generated build output and local env
.vercel/output/
.vercel/.env.*
.env*
