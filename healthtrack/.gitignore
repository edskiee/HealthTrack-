# =============================================================================
# HealthTrack — Git Ignore
# =============================================================================

# ─── Secrets & credentials (NEVER commit these) ──────────────────────────────
.env
*.env
.env.*
!.env.example
backend_nodejs/.env
backend_nodejs/.env.*
!backend_nodejs/.env.example

# Firebase / Google Cloud service account JSON key files
**/firebase-adminsdk-*.json
**/serviceAccountKey.json
**/google-services-private*.json
backend_nodejs/healthtrack-*.json
# Allow package.json and package-lock.json but block all other JSON key files
# Note: *.json is intentionally NOT blocked globally — only key file patterns above

# ─── Node.js ─────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ─── Build outputs ────────────────────────────────────────────────────────────
/build/
**/build/
dist/
.dart_tool/

# ─── Flutter/Dart ─────────────────────────────────────────────────────────────
**/doc/api/
**/ios/Flutter/.last_build_id
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
app.*.symbols
app.*.map.json
/android/app/debug
/android/app/profile
/android/app/release
android_backup/

# ─── IDE & OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
*.swp
*.swo
.atom/
.history/
.svn/
.swiftpm/
migrate_working_dir/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
backend_nodejs/test_output.txt

# ─── Test artifacts ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Miscellaneous ────────────────────────────────────────────────────────────
*.class
*.pyc
*.py[cod]
.buildlog/
.build/
