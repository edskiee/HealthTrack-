# ── Ignore Flutter platform source directories ────────────────────────────────
android/
android_backup/
ios/
macos/
windows/
linux/

# ── Ignore Flutter source & Dart tool artifacts ──────────────────────────────
lib/
assets/
web/
.dart_tool/
.idea/
.kiro/
.qoder/
.vscode/

# ── Ignore Node/backend ───────────────────────────────────────────────────────
backend_nodejs/
node_modules/
database/

# ── Ignore non-web build artifacts ───────────────────────────────────────────
build/app/
build/.cxx/
build/firebase_core/
build/firebase_messaging/
build/flutter_local_notifications/
build/flutter_plugin_android_lifecycle/
build/flutter_timezone/
build/image_picker_android/
build/native_assets/
build/network_info_plus/
build/path_provider_android/
build/printing/
build/reports/
build/shared_preferences_android/
build/3a99825705ea5132e65ecf51c322b5aa/
build/c6d7d221ac7baa3f988416538c2ed756/
build/*.dill
build/*.cache

# ── Ignore large canvaskit/wasm inside build/web (optional, reduces upload) ──
build/web/canvaskit/
build/web/**/*.wasm

# ── Ignore root-level scripts, test files, docs ──────────────────────────────
*.js
*.dart
*.sql
*.yaml
*.lock
*.md
*.iml
*.html
*.local
*.bat
*.ps1
*.py
*.txt

# ── Always keep vercel.json ───────────────────────────────────────────────────
!vercel.json
