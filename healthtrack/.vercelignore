# Vercel only needs build/web/ — exclude everything else to keep upload small

# Flutter source code (not needed — we deploy pre-built)
lib/
web/
test/
assets/

# Platform-specific native code
android/
ios/
macos/
windows/
linux/
android_backup/

# Backend (separate deployment)
backend_nodejs/
database/

# Dependencies & tooling
node_modules/
.dart_tool/
.pub-cache/
.pub/

# IDE
.idea/
.vscode/
.kiro/
.qoder/

# All build artifacts EXCEPT build/web/
build/app/
build/.cxx/
build/native_assets/
build/firebase_core/
build/firebase_messaging/
build/flutter_local_notifications/
build/flutter_plugin_android_lifecycle/
build/flutter_timezone/
build/image_picker_android/
build/network_info_plus/
build/path_provider_android/
build/printing/
build/reports/
build/shared_preferences_android/

# Vercel generated files
.vercel/output/
