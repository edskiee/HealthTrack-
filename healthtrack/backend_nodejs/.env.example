# ─── Database (Railway MySQL) ───────────────────────────────────────────────
DB_HOST=your-railway-mysql-host.railway.app
DB_USER=root
DB_PASS=your_strong_database_password
DB_NAME=healthtrack
DB_PORT=3306

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=10000
NODE_ENV=production

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_minimum_64_character_random_hex_secret_here
JWT_EXPIRES_IN=24h

# ─── CORS ────────────────────────────────────────────────────────────────────
# Your Flutter web app URL (from Vercel, Netlify, etc.)
ALLOWED_ORIGINS=https://your-flutter-app.vercel.app

# ─── Firebase Cloud Messaging ────────────────────────────────────────────────
# Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_LINES\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ─── Scheduler ───────────────────────────────────────────────────────────────
NOTIFICATION_TIMEZONE=Asia/Manila

# ─── Optional ────────────────────────────────────────────────────────────────
TEST_MODE=false
BUILD_NUMBER=local
